<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shizuku: akses shell/ADB tanpa root. -->
    <uses-permission android:name="rikka.shizuku.manager.permission.API_V23" />

    <!-- v0.1 SENGAJA tanpa INTERNET dan tanpa QUERY_ALL_PACKAGES:
         preset & optimasi dasar tidak membutuhkannya. QUERY_ALL_PACKAGES
         baru ditambah di v0.2 saat daftar aplikasi dikelola. -->
    <queries>
        <!-- Untuk cek apakah aplikasi Shizuku terpasang. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".OptApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OptMobileku">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Provider Shizuku: wajib agar Shizuku manager menemukan aplikasi ini
             dan menyerahkan binder API. Class-nya dari artifact terpisah
             dev.rikka.shizuku:provider (di v13 dipisah dari api). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true" />

    </application>
</manifest>
